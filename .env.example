# Set a deployment-specific name and environment.
CODE_AGENT_NAME=code-agent
CODE_AGENT_ENV=development

# Optional URL for your knowledge/retrieval service.
KNOWLEDGE_BASE_URL=

# Supply provider credentials only through your secret manager or local .env.
LLM_API_KEY=
SOURCE_CONTROL_TOKEN=

# Deep Agents + AWS Bedrock. These are safe example values, not credentials.
DEEP_AGENT_ENABLED=true
DEEP_AGENT_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
AWS_REGION=us-east-1
# Restrict agent source repositories to this directory.
SANDBOX_SOURCE_ROOT=./repositories
# Temporary isolated workspaces are created here.
SANDBOX_WORK_ROOT=./.agent-sandboxes
